---
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import Blocks from '../components/Blocks.astro';
import SubsplashEmbed from '../components/SubsplashEmbed.astro';
import { splitHero, sections, type Segment } from '../lib/page';
import { pageImages } from '../lib/images';
import { site } from '../../site.config';

const { page } = Astro.props;
const split = splitHero(page.segments);
// A page that is empty on the old site uses the menu's own labels.
const navLabel = (href: string) =>
  site.nav.flatMap((n) => [n, ...(n.children ?? [])]).find((n) => n.href === href)?.label ?? '';
const isEmpty = page.segments.length === 0;
const heading = isEmpty ? navLabel('/media/live') : split.heading;
const { eyebrow, body } = split;

// Leading plain lines after the title read as the hero's lead.
let leadEnd = 0;
while (leadEnd < body.length && body[leadEnd].kind === 'p' && !body[leadEnd].href) leadEnd += 1;
const lead = body.slice(0, leadEnd).map((s) => s.text);
const groups = sections(body.slice(leadEnd));

const srcOf = (tag: string) => tag.match(/src="([^"]+)"/)?.[1]?.replace(/&amp;/g, '&');
const embeds = (page.embeds.map(srcOf).filter((s: string) => s?.includes('subsplash')) as string[]);
// Pages that are empty on the old site still get the live player.
const playerSrc = embeds[0] ?? (page.segments.length === 0 ? site.subsplash.liveEmbed : undefined);
const isGiving = !!playerSrc?.includes('/give');
const outLink = site.externalContent[page.path];
const photo = pageImages(page.images)[0];

// Section shapes, detected from the content itself.
const DATE_LINE = /^[A-Z][a-z]{2} \d{1,2}, \d{4} • /;
const isLinkList = (g: Segment[]) => g.filter((s) => s.kind === 'p').length > 1 && g.every((s) => s.kind !== 'p' || s.href);
const isDated = (g: Segment[]) => g.some((s) => DATE_LINE.test(s.text));
const h3Count = (g: Segment[]) => g.filter((s) => s.kind === 'h3').length;

function uniqueLinks(g: Segment[]) {
  const seen = new Set<string>();
  return g.filter((s) => s.kind === 'p' && s.href).filter((s) => {
    const key = `${s.text}|${s.href}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
}
function datedCards(g: Segment[]) {
  const head = g.filter((s) => s.kind !== 'p');
  const cards: { title: Segment; date?: string }[] = [];
  const ps = g.filter((s) => s.kind === 'p');
  for (let i = 0; i < ps.length; i++) {
    if (DATE_LINE.test(ps[i + 1]?.text ?? '')) { cards.push({ title: ps[i], date: ps[i + 1].text }); i += 1; }
    else cards.push({ title: ps[i] });
  }
  return { head, cards };
}
function h3Cards(g: Segment[]) {
  const head: Segment[] = [];
  const cards: Segment[][] = [];
  for (const s of g) {
    if (s.kind === 'h3') cards.push([s]);
    else if (cards.length) cards[cards.length - 1].push(s);
    else head.push(s);
  }
  return { head, cards };
}
---
<Base title={page.title} description={page.description} currentPath={page.path}>
  <section class:list={['media-hero', 'tone-light-2', { 'has-player': playerSrc }]}>
    {photo && !playerSrc && (
      <Picture src={photo} alt="" formats={['avif', 'webp']} widths={[800, 1600, 2400]} sizes="100vw" class="bg" loading="eager" fetchpriority="high" />
    )}
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      {(heading || eyebrow.length > 0) && (
        <div class="hero-copy reveal">
          {eyebrow.map((e) => <p class="eyebrow">{e}</p>)}
          {heading && <h1 class="display">{heading}</h1>}
          {lead.map((l, i) => <p class:list={['lead', { meta: i === 0 && lead.length > 1 }]}>{l}</p>)}
          {isEmpty && <a class="btn btn-ghost out" href="/sermons">{navLabel('/sermons')}</a>}
          {outLink && (
            <a class="btn btn-primary out" href={outLink} rel="noopener" target="_blank">
              {heading}
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 3h8v8M13 3 3 13" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            </a>
          )}
        </div>
      )}
      {playerSrc && (
        <div class="player reveal">
          <SubsplashEmbed src={playerSrc} title={isGiving ? 'Giving form' : 'Media player'} ratio={isGiving ? '3 / 4' : '16 / 9'} />
        </div>
      )}
    </div>
  </section>

  {groups.map((g, i) => {
    const tone = i % 2 ? 'tone-light-2' : 'tone-light';
    if (isLinkList(g)) {
      const head = g.filter((s) => s.kind !== 'p');
      return (
        <section class:list={['band', tone]}>
          <div class="container">
            <Blocks segments={head} />
            <ul class="chips" role="list">
              {uniqueLinks(g).map((l) => (
                <li><a href={l.href} {...(/^https?:/.test(l.href!) ? { rel: 'noopener', target: '_blank' } : {})}>{l.text}</a></li>
              ))}
            </ul>
          </div>
        </section>
      );
    }
    if (isDated(g)) {
      const { head, cards } = datedCards(g);
      return (
        <section class="band tone-light-2">
          <div class="container">
            <div><Blocks segments={head} /></div>
            <ul class="cards" role="list">
              {cards.map((c) => (
                <li class="card reveal">
                  <p class="card-title">
                    {c.title.href ? <a href={c.title.href} rel="noopener" target={/^https?:/.test(c.title.href) ? '_blank' : undefined}>{c.title.text}</a> : c.title.text}
                  </p>
                  {c.date && <p class="card-date">{c.date}</p>}
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    }
    if (h3Count(g) >= 2) {
      const { head, cards } = h3Cards(g);
      return (
        <section class:list={['band', tone]}>
          <div class="container">
            {head.length > 0 && <div class="read"><Blocks segments={head} /></div>}
            <div class="tiles">
              {cards.map((c) => <div class="tile reveal"><Blocks segments={c} /></div>)}
            </div>
          </div>
        </section>
      );
    }
    return (
      <section class:list={['band', tone]}>
        <div class="container read reveal"><Blocks segments={g} forms={page.forms} pagePath={page.path} /></div>
      </section>
    );
  })}
</Base>

<style>
  .media-hero { position: relative; overflow: hidden; padding-block: clamp(56px, 9vw, 120px); }
  .media-hero > :global(picture) { position: absolute; inset: 0; opacity: .12; }
  .media-hero :global(.bg) { width: 100%; height: 100%; object-fit: cover; }
  .glow {
    position: absolute; inset: auto -20% -60% auto; width: 70vw; height: 70vw; border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--accent-rgb) / .28), rgb(var(--accent-rgb) / 0) 65%);
    pointer-events: none;
  }
  .hero-grid { position: relative; display: grid; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .has-player .hero-grid { grid-template-columns: 1fr; }
  @media (min-width: 960px) { .has-player .hero-grid { grid-template-columns: .85fr 1.15fr; } }
  .hero-copy h1 { font-size: clamp(2.6rem, 6vw, 4.8rem); line-height: 1.02; color: var(--ink); }
  .eyebrow { margin: 0 0 14px; }
  .lead { color: #333; max-width: 60ch; margin: 16px 0 0; }
  .lead.meta { color: var(--blue); font-weight: 700; letter-spacing: .02em; }
  .out { margin-top: 28px; }
  .band { padding-block: clamp(48px, 7vw, 96px); }
  .chips { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chips a {
    display: inline-flex; padding: 10px 18px; border-radius: 999px; text-decoration: none;
    border: 1.5px solid rgba(17, 17, 17, .18); font-weight: 600; font-size: .95rem; color: var(--ink);
    transition: border-color .2s var(--ease), background-color .2s var(--ease);
  }
  .chips a:hover { border-color: var(--accent); background: rgb(var(--accent-rgb) / .08); }
  .on-dark { color: #fff; }
  .cards { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .card { position: relative; padding: 22px; border-radius: var(--radius); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .card-title { margin: 0 0 6px; color: var(--ink); font-weight: 700; line-height: 1.35; }
  .card-title a { color: inherit; text-decoration: none; }
  .card-title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card:hover { border-color: rgb(var(--accent-rgb) / .6); }
  .card-date { margin: 0; color: #555; font-size: .9rem; }
  .tiles { display: grid; gap: 18px; margin-top: 28px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .tile { padding: 28px; border-radius: var(--radius-lg); background: var(--paper); box-shadow: 0 10px 30px -18px rgba(0, 0, 0, .35); border-top: 4px solid var(--accent); }
  .tone-light .tile { background: var(--paper-2); }
</style>
