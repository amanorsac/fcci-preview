---
// The redesigned home page. Every line of the church's own home page appears
// here; new lines come from src/content/draft/home.json.
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import ImageSlot from '../components/ImageSlot.astro';
import SubsplashEmbed from '../components/SubsplashEmbed.astro';
import ServiceTimes from '../components/ServiceTimes.astro';
import { homeModel } from '../lib/home';
import { pageImages } from '../lib/images';
import { slot } from '../lib/slots';
import { draft } from '../lib/draft';
import { site } from '../../site.config';

const { page } = Astro.props;
const m = homeModel(page.segments);
const d = (k: string) => draft('home', k);
const flyer = pageImages(page.images)[0];
const navLabel = (href: string) =>
  site.nav.flatMap((n) => [n, ...(n.children ?? [])]).find((n) => n.href === href)?.label ?? '';
const plan = site.headerCtas[0];
const times = site.footer.filter((s) => /\d{1,2}:\d{2}/.test(s.text)).map((s) => s.text);

// Sections after the pillars: the church's "Latest Teaching" block.
const teaching = m.rest.find((sec) => sec.some((s) => s.href === '/sermons')) ?? [];
const teachingHeading = teaching.find((s) => s.kind !== 'p');
const teachingLinks = teaching.filter((s) => s.href);
const otherRest = m.rest.filter((sec) => sec !== teaching);
const srcOf = (tag: string) => tag.match(/src="([^"]+)"/)?.[1]?.replace(/&amp;/g, '&');
const mediaEmbed = page.embeds.map(srcOf).find((s: string) => s?.includes('/media/embed'));

const pillarSlots = ['home.reach', 'home.teach', 'home.transform'];
const tiles = [
  { href: '/i-m-new', label: navLabel('/i-m-new'), text: d('tile.new'), slot: 'tile.new' },
  { href: site.kids.path, label: site.kids.name, text: d('tile.kids'), slot: 'tile.kids' },
  { href: '/students', label: navLabel('/students'), text: d('tile.youth'), slot: 'tile.youth' },
  { href: '/connect-groups', label: navLabel('/connect-groups'), text: d('tile.groups'), slot: 'tile.groups' },
];
const steps = [1, 5, 6].map((n) => ({
  title: draft('next-steps', `${n}.title`),
  text: draft('next-steps', `${n}.text`),
  href: ['/i-m-new', '/connect-groups', '/dream-team'][[1, 5, 6].indexOf(n)],
}));
---
<Base title={page.title} description={page.description} currentPath="/">
  <!-- HERO -->
  <section class="hero tone-light-2" data-section="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="display">{m.heading}</h1>
        {m.lines.map((l, i) => <p class:list={['lead', { invite: i === m.lines.length - 1 }]}>{l}</p>)}
        <ul class="times" role="list">{times.map((t) => <li>{t}</li>)}</ul>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={plan.href}>{plan.label}</a>
          <a class="btn btn-ghost" href="/media/live">{navLabel('/media/live')}</a>
        </div>
        <p class="sub-links">
          {m.ctas.map((c) => <a href={c.href}>{c.text}</a>)}
        </p>
      </div>
      <div class="hero-media">
        <ImageSlot pair={slot('home.hero')} sizes="(min-width: 960px) 46vw, 100vw" class="hero-img" eager />
      </div>
    </div>
  </section>

  <!-- REACH · TEACH · TRANSFORM -->
  <section class="pillars grad-band" data-section="pillars">
    {m.intro.map((t) => <p class="intro container display-italic">{t}</p>)}
    <div class="container pillar-grid">
      {m.pillars.map((p, i) => (
        <article class="pillar reveal">
          {pillarSlots[i] && (
            <div class="pillar-media"><ImageSlot pair={slot(pillarSlots[i])} sizes="(min-width: 900px) 30vw, 100vw" widths={[480, 800, 1200]} /></div>
          )}
          <h2 class="pillar-word display-italic">{p.word}</h2>
          {p.sub && <h3 class="pillar-sub">{p.sub}</h3>}
          {p.body.map((b) => <p>{b.text}</p>)}
        </article>
      ))}
    </div>
  </section>

  <!-- TAILOR -->
  <section class="band tone-light" data-section="tailor">
    <div class="container">
      <p class="eyebrow">{d('tailor.eyebrow')}</p>
      <h2 class="display sec-title">{d('tailor.title')}</h2>
      <ul class="tiles" role="list">
        {tiles.map((t) => (
          <li class="tile reveal">
            <a href={t.href}>
              <ImageSlot pair={slot(t.slot)} sizes="(min-width: 900px) 25vw, 50vw" widths={[400, 800]} class="tile-img" />
              <span class="tile-shade" aria-hidden="true"></span>
              <span class="tile-text"><span class="tile-label">{t.label}</span><span class="tile-sub">{t.text}</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- KIDS SPOTLIGHT -->
  <section class="band kids" data-section="kids">
    <div class="container kids-grid">
      <div class="kids-media reveal"><ImageSlot pair={slot('kids.hero')} sizes="(min-width: 900px) 45vw, 100vw" widths={[480, 800, 1200]} /></div>
      <div class="kids-copy reveal">
        <p class="eyebrow">{site.kids.when}</p>
        <h2 class="display-italic kids-title">{site.kids.name}</h2>
        <p>{d('kids.text')}</p>
        <a class="btn btn-dark" href={site.kids.path}>{d('kids.cta')}</a>
      </div>
    </div>
  </section>

  <!-- LATEST TEACHING -->
  <section class="band tone-light-2" data-section="sermon">
    <div class="container split">
      <div>
        {teachingHeading && <h2 class="display sec-title">{teachingHeading.text}</h2>}
        {teachingLinks.map((l) => <a class="btn btn-primary" href={l.href}>{l.text}</a>)}
      </div>
      {mediaEmbed && <SubsplashEmbed src={mediaEmbed} title="Media player" />}
    </div>
  </section>

  <!-- EVENTS -->
  <section class="band tone-light" data-section="events">
    <div class="container">
      <p class="eyebrow">{d('events.eyebrow')}</p>
      <h2 class="display sec-title">{d('events.title')}</h2>
      <div class="events">
        {m.announcements.map((a) => (
          <a class="event-card" href={a.href} rel="noopener" target="_blank">
            {flyer && <Picture src={flyer} alt="" formats={['avif', 'webp']} widths={[480, 900]} sizes="(min-width: 900px) 50vw, 100vw" class="event-img" />}
            <span class="event-text">{a.text}</span>
          </a>
        ))}
        <a class="btn btn-ghost" href="/calendar">{navLabel('/calendar')}</a>
      </div>
      {otherRest.map((sec) => (
        <div class="read"><p>{sec.map((s) => s.text).join(' ')}</p></div>
      ))}
    </div>
  </section>

  <!-- DREAM TEAM -->
  <section class="band dream" data-section="dream-team">
    <div class="container dream-grid">
      <div class="dream-media reveal"><ImageSlot pair={slot('team.guest')} sizes="(min-width: 900px) 45vw, 100vw" widths={[480, 800, 1200]} /></div>
      <div class="reveal">
        <p class="eyebrow">{draft('dream-team', 'eyebrow')}</p>
        <h2 class="display sec-title">{draft('dream-team', 'title')}</h2>
        <p>{d('dream.text')}</p>
        <a class="btn btn-primary" href="/dream-team">{draft('dream-team', 'form.title')}</a>
      </div>
    </div>
  </section>

  <!-- NEXT STEPS -->
  <section class="band tone-light-2" data-section="next-steps">
    <div class="container">
      <h2 class="display sec-title center">{d('next.title')}</h2>
      <ol class="next" role="list">
        {steps.map((s, i) => (
          <li class="next-card reveal">
            <span class="next-n display" aria-hidden="true">{i + 1}</span>
            <h3><a href={s.href}>{s.title}</a></h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- VISIT -->
  <div data-section="visit"><ServiceTimes segments={site.footer} id="service-times" columns={2} /></div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; }
  .glow { position: absolute; width: 70vw; height: 70vw; right: -20vw; top: -35vw; border-radius: 50%; background: radial-gradient(circle, rgb(var(--accent-rgb) / .18), rgb(var(--accent-rgb) / 0) 65%); pointer-events: none; }
  .hero-grid { position: relative; display: grid; gap: clamp(28px, 5vw, 64px); align-items: center; padding-block: clamp(48px, 8vw, 104px); min-height: calc(88svh - var(--header-h)); }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1.05fr .95fr; } }
  .hero h1 { font-size: clamp(3.4rem, 9vw, 7rem); line-height: .95; }
  .lead { max-width: 56ch; margin: 18px 0 0; font-size: 1.12rem; color: #333; }
  .lead.invite { font-weight: 900; color: var(--ink); }
  .times { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .times li { padding: 8px 16px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-weight: 900; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .sub-links { display: flex; flex-wrap: wrap; gap: 6px 20px; margin: 18px 0 0; }
  .sub-links a { font-weight: 700; color: var(--blue); }
  .hero-media { position: relative; isolation: isolate; }
  .hero-media :global(.hero-img) { width: 100%; height: auto; aspect-ratio: 4 / 3.4; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .hero-media::before { content: ''; position: absolute; inset: auto -16px -16px auto; width: 62%; height: 62%; border-radius: var(--radius-lg); background: var(--grad); z-index: -1; }

  .pillars { padding-block: clamp(64px, 9vw, 120px); }
  .intro { font-size: clamp(2rem, 4.6vw, 3.2rem); margin: 0 auto 28px; }
  .pillar-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .pillar { background: rgba(255, 255, 255, .92); border-radius: var(--radius-lg); padding: 14px 14px 28px; box-shadow: 0 30px 60px -40px rgba(0, 0, 0, .5); }
  .pillar-media { border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 3; margin-bottom: 18px; }
  .pillar-media :global(picture), .pillar-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pillar-word { font-size: clamp(2.6rem, 4.6vw, 3.6rem); line-height: 1.05; margin: 0 12px; overflow-wrap: normal; word-break: keep-all; padding-right: .1em; background: var(--grad-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .pillar-sub { font: 900 1rem/1.35 var(--font-body); letter-spacing: .06em; text-transform: uppercase; margin: 10px 12px; }
  .pillar p { margin: 0 12px; color: #333; }

  .band { padding-block: clamp(56px, 8vw, 104px); }
  .sec-title { font-size: clamp(2.2rem, 5vw, 3.4rem); margin: 0 0 28px; }
  .sec-title.center { text-align: center; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .tile a { position: relative; display: block; aspect-ratio: 3 / 4; border-radius: var(--radius-lg); overflow: hidden; color: #fff; text-decoration: none; }
  .tile :global(picture), .tile :global(.tile-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .tile a:hover :global(.tile-img) { transform: scale(1.05); }
  .tile-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(17, 17, 17, .85), rgba(17, 17, 17, .1) 60%); }
  .tile-text { position: absolute; left: 18px; right: 18px; bottom: 18px; display: grid; gap: 4px; }
  .tile-label { font: 400 1.7rem/1.1 var(--font-display); }
  .tile-sub { font-size: .95rem; color: rgba(255, 255, 255, .9); }

  .kids { background: var(--grad); }
  .kids-grid, .dream-grid { display: grid; gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (min-width: 900px) { .kids-grid, .dream-grid { grid-template-columns: 1fr 1fr; } }
  .kids-media, .dream-media { border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); aspect-ratio: 4 / 3; }
  .kids-media :global(picture), .kids-media :global(img), .dream-media :global(picture), .dream-media :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kids .eyebrow { color: var(--ink); }
  .kids-title { font-size: clamp(3rem, 8vw, 6rem); line-height: 1; margin: 0 0 16px; }
  .kids-copy p { font-size: 1.12rem; max-width: 48ch; }
  :global(.btn-dark) { background: var(--ink); color: #fff; }
  :global(.btn-dark:hover) { background: #000; }

  .split { display: grid; gap: clamp(28px, 5vw, 56px); align-items: center; }
  @media (min-width: 900px) { .split { grid-template-columns: .8fr 1.2fr; } }
  .events { display: grid; gap: 18px; align-items: center; }
  @media (min-width: 900px) { .events { grid-template-columns: 1.4fr auto; } }
  .event-card { display: grid; grid-template-columns: 160px 1fr; gap: 18px; align-items: center; padding: 12px; border-radius: var(--radius-lg); background: var(--paper-2); color: var(--ink); text-decoration: none; font-weight: 900; }
  .event-card:hover { box-shadow: var(--shadow-sm); }
  .event-card :global(.event-img) { width: 160px; height: 100px; object-fit: cover; border-radius: 14px; }
  @media (max-width: 520px) { .event-card { grid-template-columns: 1fr; } .event-card :global(.event-img) { width: 100%; height: auto; aspect-ratio: 16 / 10; } }

  .dream { background: var(--paper); }
  .next { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .next-card { position: relative; padding: 28px; border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-sm); }
  .next-n { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--grad); font-size: 1.6rem; margin-bottom: 14px; }
  .next-card h3 { font: 900 1.2rem/1.3 var(--font-body); margin: 0 0 6px; }
  .next-card h3 a { color: var(--ink); text-decoration: none; }
  .next-card h3 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .next-card p { margin: 0; color: #444; }
</style>
