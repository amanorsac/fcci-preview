---
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Blocks from '../components/Blocks.astro';
import { splitHero, sections } from '../lib/page';
import { pageImages } from '../lib/images';

const { page } = Astro.props;
const { heading, eyebrow, body } = splitHero(page.segments);
const images = pageImages(page.images);
const groups = sections(body);
---
<Base title={page.title} description={page.description} currentPath={page.path}>
  <Hero heading={heading} eyebrow={eyebrow} image={images[0]} size="compact" />
  {groups.map((g, i) => (
    <section class:list={['band', i % 2 ? 'tone-light-2' : 'tone-light']}>
      <div class="container band-inner">
        <div class="read reveal"><Blocks segments={g} forms={page.forms} pagePath={page.path} /></div>
      </div>
    </section>
  ))}
</Base>

<style>
  .band { padding-block: clamp(48px, 7vw, 96px); }
  .band-inner { display: grid; }
</style>
