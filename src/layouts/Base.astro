---
import '../styles/base.css';
import { site } from '../../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreviewStrip from '../components/PreviewStrip.astro';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  /** False when the page carries its own footer text (chrome mismatch). */
  sharedFooter?: boolean;
}
const { title, description = '', currentPath = '/', sharedFooter = true } = Astro.props;
const c = site.colors;
const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)).join(' ');
const themeVars = `:root{--accent:${c.accent};--accent-rgb:${rgb(c.accent)};--accent-hover:${c.accentHover};--ink:${c.ink};--ink-2:${c.ink2};--gray:${c.gray};--paper:${c.paper};--paper-2:${c.paper2};--blue:${c.blue};--grad:linear-gradient(135deg, ${c.gradFrom}, ${c.gradTo});}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content={c.paper} />
    <link rel="icon" href={site.favicon} />
    <link rel="preload" href="/fonts/abril-fatface-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lato-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style set:html={themeVars}></style>
    <script is:inline>try{if(sessionStorage.getItem('preview-img')==='ai')document.documentElement.classList.add('img-ai')}catch(e){}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{site.ui.skipLink}</a>
    {site.preview.enabled && <PreviewStrip text={site.preview.text} churchLabel={site.preview.churchPhotos} aiLabel={site.preview.aiImages} />}
    <Header nav={site.nav} ctas={site.headerCtas} logo={site.logo} name={site.name} currentPath={currentPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer segments={sharedFooter ? site.footer : []} links={site.footerLinks} socials={site.socials} logo={site.logo} name={site.name} />
    <script>
      const motionOK = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (motionOK && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-on');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
