---
import { Picture } from 'astro:assets';
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Blocks from '../components/Blocks.astro';
import { splitHero, sections } from '../lib/page';
import { pageImages } from '../lib/images';
import { pagePair } from '../lib/slots';

const { page } = Astro.props;
const { heading, eyebrow, body } = splitHero(page.segments);
const images = pageImages(page.images);
const groups = sections(body);
// Each section after the first is paired with the next page photo, if any.
const photoFor = (i: number) => images[i + 1];
---
<Base title={page.title} description={page.description} currentPath={page.path}>
  <Hero heading={heading} eyebrow={eyebrow} pair={pagePair(page)} size="tall" />
  {groups.map((g, i) => {
    const photo = photoFor(i);
    return (
      <section class:list={['band', i % 2 ? 'tone-light-2' : 'tone-light']}>
        <div class:list={['container', 'split', { 'has-photo': photo, flip: i % 2 }]}>
          <div class="copy reveal"><Blocks segments={g} forms={page.forms} pagePath={page.path} /></div>
          {photo && (
            <figure class="photo reveal" aria-hidden="true">
              <Picture src={photo} alt="" formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 900px) 45vw, 100vw" loading="lazy" />
            </figure>
          )}
        </div>
      </section>
    );
  })}
</Base>

<style>
  .band { padding-block: clamp(56px, 8vw, 112px); }
  .split { display: grid; gap: clamp(28px, 5vw, 64px); align-items: center; }
  .copy { max-width: var(--read); }
  .photo { margin: 0; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .photo :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  @media (min-width: 900px) {
    .split.has-photo { grid-template-columns: 1.1fr .9fr; }
    .split.has-photo.flip .copy { order: 2; }
  }
</style>
