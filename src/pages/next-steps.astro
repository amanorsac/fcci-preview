---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { draft } from '../lib/draft';
import { slot } from '../lib/slots';
import { site } from '../../site.config';

const d = (k: string) => draft('next-steps', k);
const hrefs = ['/i-m-new', '/jesus', '/growth-track', '/baptism-signup', '/connect-groups', '/dream-team'];
const steps = hrefs.map((href, i) => ({ href, title: d(`${i + 1}.title`), text: d(`${i + 1}.text`) }));
---
<Base title={`${d('eyebrow')} | ${site.name}`} description={d('lead')} currentPath="/next-steps">
  <Hero heading={d('title')} eyebrow={[d('eyebrow')]} lead={[d('lead')]} pair={slot('next-steps')} size="compact" />
  <section class="band tone-light">
    <div class="container">
      <ol class="path" role="list">
        {steps.map((s, i) => (
          <li class="step reveal">
            <span class="n display" aria-hidden="true">{i + 1}</span>
            <div>
              <h2><a href={s.href}>{s.title}</a></h2>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .band { padding-block: clamp(48px, 7vw, 96px); }
  .path { list-style: none; margin: 0 auto; padding: 0; max-width: 820px; display: grid; gap: 14px; position: relative; }
  .step {
    position: relative; display: grid; grid-template-columns: auto 1fr; gap: 22px; align-items: center;
    padding: 24px 28px; border-radius: var(--radius-lg); background: var(--paper-2); transition: transform .2s var(--ease), box-shadow .2s var(--ease);
  }
  .step:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .n { width: 64px; height: 64px; border-radius: 50%; display: grid; place-items: center; font-size: 2rem; background: var(--grad); color: var(--ink); }
  .step h2 { font: 900 1.25rem/1.3 var(--font-body); margin: 0 0 4px; }
  .step h2 a { color: var(--ink); text-decoration: none; }
  .step h2 a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .step p { margin: 0; color: #444; }
</style>
