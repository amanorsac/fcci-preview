---
// A lazy third-party media frame. The surrounding section always keeps its
// own source link, so the page stays usable if the frame is blocked.
interface Props { src: string; title: string; ratio?: string }
const { src, title, ratio = '16 / 9' } = Astro.props;
---
<div class="embed" style={`aspect-ratio:${ratio}`}>
  <iframe src={src} title={title} loading="lazy" allow="clipboard-read; clipboard-write; fullscreen" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>

<style>
  .embed { position: relative; width: 100%; border-radius: var(--radius-lg); overflow: hidden; background: var(--ink-2); box-shadow: var(--shadow); }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
