---
interface Segment { kind: string; text: string; href?: string }
interface Props {
  segments: Segment[];
  links: Record<string, string>;
  socials: { network: string; href: string; label: string }[];
  logo: { src: string; width: number; height: number };
  name: string;
}
const { segments, links, socials, logo, name } = Astro.props;

// Group the verbatim footer lines into columns at each h3.
const columns: { heading: Segment; lines: Segment[] }[] = [];
for (const s of segments) {
  if (s.kind === 'h3') columns.push({ heading: s, lines: [] });
  else columns.at(-1)?.lines.push(s);
}
const hrefOf = (s: Segment) => links[s.text] ?? s.href;
const isExternal = (h?: string) => !!h && /^https?:/.test(h);

const ICONS: Record<string, string> = {
  facebook: 'M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.6.4-1 1-1z',
  instagram: 'M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 3c-2.4 0-2.7 0-3.7.1C5.6 3.2 3.2 5.6 3.1 8.3 3 9.3 3 9.6 3 12s0 2.7.1 3.7c.1 2.7 2.5 5.1 5.2 5.2 1 .1 1.3.1 3.7.1s2.7 0 3.7-.1c2.7-.1 5.1-2.5 5.2-5.2.1-1 .1-1.3.1-3.7s0-2.7-.1-3.7c-.1-2.7-2.5-5.1-5.2-5.2C14.7 3 14.4 3 12 3z',
  x: 'M4 3h4.6l4 5.6L17.3 3H20l-6.1 7.1L21 21h-4.6l-4.4-6.1L6.7 21H4l6.6-7.6z',
};
---
<footer class="site-footer tone-dark">
  <div class="container inner">
    <a class="logo" href="/" aria-label={name}><img src={logo.src} alt="" width={logo.width} height={logo.height} loading="lazy" /></a>
    <div class="cols">
      {columns.map((col) => (
        <div class="col">
          <h2 class="eyebrow">{col.heading.text}</h2>
          {col.lines.length > 0 && (
            <ul>
              {col.lines.map((l) => {
                const href = hrefOf(l);
                return (
                  <li>
                    {href ? (
                      <a href={href} {...(isExternal(href) ? { rel: 'noopener', target: '_blank' } : {})}>{l.text}</a>
                    ) : (
                      <span>{l.text}</span>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
          {col === columns.at(-1) && (
            <div class="socials">
              {socials.map((s) => (
                <a href={s.href} aria-label={s.label} rel="noopener" target="_blank">
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={ICONS[s.network]} fill="currentColor" /></svg>
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: clamp(56px, 8vw, 96px) 0 48px; border-top: 3px solid var(--accent); }
  .inner { display: grid; gap: 40px; }
  .logo img { height: 56px; width: auto; }
  .cols { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .col h2 { color: var(--accent); margin-bottom: 14px; }
  .col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .col li { color: rgba(255,255,255,.82); font-size: .95rem; }
  .col a { color: rgba(255,255,255,.9); text-decoration: none; }
  .col a:hover { color: #fff; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: .2em; }
  .socials { display: flex; gap: 10px; }
  .socials a {
    width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%;
    background: rgba(255,255,255,.08); color: #fff; transition: background-color .2s var(--ease), color .2s var(--ease);
  }
  .socials a:hover { background: var(--accent); color: var(--ink); }
</style>
