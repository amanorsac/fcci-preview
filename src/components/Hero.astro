---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  eyebrow?: string[];
  lead?: string[];
  image?: ImageMetadata;
  size?: 'compact' | 'tall' | 'full';
  priority?: boolean;
}
const { heading, eyebrow = [], lead = [], image, size = 'compact', priority = true } = Astro.props;
---
<section class:list={['hero', 'tone-dark', `hero-${size}`]}>
  {image && (
    <Picture
      src={image}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      class="hero-img"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
    />
  )}
  <div class="scrim" aria-hidden="true"></div>
  <div class="container hero-inner">
    {eyebrow.map((e) => <p class="eyebrow">{e}</p>)}
    <h1 class:list={["display", { long: heading.length > 60 }]}>{heading}</h1>
    {lead.map((l) => <p class="lead">{l}</p>)}
    <slot />
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; display: grid; align-items: end; }
  .hero-compact { min-height: clamp(320px, 48vh, 520px); }
  .hero-tall { min-height: clamp(460px, 72vh, 760px); }
  .hero-full { min-height: calc(100svh - var(--header-h)); }
  .hero > :global(picture), .hero > :global(.hero-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero :global(.hero-img) { width: 100%; height: 100%; object-fit: cover; }
  /* Directional scrim keeps headline contrast above 4.5:1 on any photo. */
  .scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(17,17,17,.88) 0%, rgba(17,17,17,.55) 55%, rgba(17,17,17,.25) 100%),
      linear-gradient(0deg, rgba(17,17,17,.75) 0%, rgba(17,17,17,0) 60%);
  }
  @media (max-width: 699px) { .scrim { background: linear-gradient(0deg, rgba(17,17,17,.92) 0%, rgba(17,17,17,.72) 60%, rgba(17,17,17,.6) 100%); } }
  .hero-inner { position: relative; padding-block: clamp(56px, 10vw, 120px) clamp(40px, 7vw, 88px); }
  .hero h1 { font-size: clamp(3rem, 9vw, 7.5rem); line-height: .92; max-width: 16ch; color: #fff; }
  .hero h1.long { font-size: clamp(1.9rem, 3.8vw, 3rem); line-height: 1.08; max-width: 34ch; }
  .eyebrow { color: var(--accent); margin: 0 0 14px; }
  .lead { max-width: 56ch; margin: 18px 0 0; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: rgba(255,255,255,.88); }
</style>
