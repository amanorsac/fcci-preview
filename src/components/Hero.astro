---
import ImageSlot from './ImageSlot.astro';
import { hasImage, type Pair } from '../lib/slots';

interface Props {
  heading: string;
  eyebrow?: string[];
  lead?: string[];
  pair?: Pair;
  size?: 'compact' | 'tall' | 'full';
  priority?: boolean;
}
const { heading, eyebrow = [], lead = [], pair, size = 'compact', priority = true } = Astro.props;
const image = pair && hasImage(pair);
---
<section class:list={['hero', 'tone-light-2', `hero-${size}`, { 'has-img': image }]}>
  <div class="glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy">
      {eyebrow.map((e) => <p class="eyebrow">{e}</p>)}
      <h1 class:list={['display', { long: heading.length > 60 }]}>{heading}</h1>
      {lead.map((l) => <p class="lead">{l}</p>)}
      <slot />
    </div>
    {image && (
      <div class="hero-media">
        <ImageSlot pair={pair!} sizes="(min-width: 960px) 46vw, 100vw" class="hero-img" eager={priority} />
      </div>
    )}
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; }
  .glow {
    position: absolute; width: 60vw; height: 60vw; right: -18vw; top: -30vw; border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--accent-rgb) / .16), rgb(var(--accent-rgb) / 0) 65%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative; display: grid; gap: clamp(28px, 5vw, 64px); align-items: center;
    padding-block: clamp(48px, 8vw, 104px);
  }
  .hero-compact .hero-grid { min-height: clamp(260px, 40vh, 440px); }
  .hero-tall .hero-grid { min-height: clamp(380px, 60vh, 640px); }
  .hero-full .hero-grid { min-height: calc(92svh - var(--header-h)); }
  @media (min-width: 960px) { .has-img .hero-grid { grid-template-columns: 1fr 1fr; } }
  .hero h1 { font-size: clamp(2.8rem, 7vw, 5.6rem); line-height: 1; color: var(--ink); max-width: 16ch; }
  .hero h1.long { font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.15; max-width: 30ch; }
  .eyebrow { margin: 0 0 14px; }
  .lead { max-width: 56ch; margin: 18px 0 0; font-size: clamp(1.05rem, 1.5vw, 1.2rem); color: #333; }
  .hero-media { position: relative; }
  .hero-media :global(picture) { display: block; }
  .hero-media :global(.hero-img) {
    width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: var(--radius-lg); box-shadow: var(--shadow);
  }
  .hero-media::before {
    content: ''; position: absolute; inset: auto -14px -14px auto; width: 60%; height: 60%;
    border-radius: var(--radius-lg); background: var(--grad); z-index: -1; opacity: .9;
  }
  .hero-media { z-index: 0; isolation: isolate; }
</style>
